# Gradle caches and generated state
.gradle/
**/build/

# Android generated files
local.properties
captures/
.externalNativeBuild/
.cxx/

# IDE-specific files
.idea/
*.iml
.vscode/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Logs and temporary files
*.log
*.tmp
*.swp
*.swo
*~

# Local signing credentials and keystores
*.jks
*.keystore
keystore.properties
signing.properties

# Environment files that may contain secrets
.env
.env.*
!.env.example

# Private keys and certificates
*.pem
*.p12
*.pfx
*.key

# Local test outputs and reports
**/test-results/
**/reports/

# Packaged build outputs
*.apk
*.aab

# Preserve Gradle wrapper files if added later
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
